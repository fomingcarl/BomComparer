<Window x:Class="BomComparer.TopLevelReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Top Level Comparison" Height="600" Width="1200" WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Search / Filter Bars -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,10" Background="#F0F0F0">

            <TextBlock Text="Filter Category:" VerticalAlignment="Center" Margin="0,5,5,5" FontWeight="SemiBold"/>
            <TextBox x:Name="CategoryFilter" Width="200" Margin="0,5,15,5" TextChanged="Filter_TextChanged"/>

            <TextBlock Text="Filter Part No:" VerticalAlignment="Center" Margin="5,5,5,5" FontWeight="SemiBold"/>
            <TextBox x:Name="PartNoFilter" Width="120" Margin="0,5,15,5" TextChanged="Filter_TextChanged"/>

            

            <Button Content="Export Report" Click="ExportButton_Click" Width="120" Height="25" FontWeight="SemiBold" Margin="20,5,5,5"/>
        </StackPanel>

        <!-- DataGrid with Row Highlighting -->
        <DataGrid x:Name="ReportGrid" Grid.Row="1" AutoGenerateColumns="True" IsReadOnly="True" 
                  SelectionUnit="CellOrRowHeader" ClipboardCopyMode="IncludeHeader">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter Property="Background" Value="#E3F2FD" />
                            <!-- Light Blue Highlight -->
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
        </DataGrid>
    </Grid>
</Window>