<Window x:Class="BomComparer.FrequencyMismatchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Parent Hierarchy Details" Height="450" Width="900" WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <DataGrid x:Name="UnifiedDataGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionUnit="CellOrRowHeader" ClipboardCopyMode="IncludeHeader">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Setter Property="Background" Value="{Binding RowColor}"/>
                    <Style.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter Property="Background" Value="#E3F2FD" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Source File" Binding="{Binding SourceFile}" FontWeight="Bold"/>
                <DataGridTextColumn Header="Instance ID" Binding="{Binding InstanceId}"/>

                <!-- NEW COLUMN ADDED HERE -->
                <DataGridTextColumn Header="Parent Level" Binding="{Binding ParentLevel}"/>

                <DataGridTextColumn Header="Parent Part No" Binding="{Binding ParentPartNo}"/>
                <DataGridTextColumn Header="Parent Description" Binding="{Binding ParentDescription}"/>
                <DataGridTextColumn Header="Parent Rev" Binding="{Binding ParentRevision}"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>