<!-- Location: MainWindow.xaml -->
<Window x:Class="BomComparer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="BOM Comparer" Height="600" Width="1000">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid>
        <Grid Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <!-- Side Panel for File Queue -->
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
                <!-- Main DataGrid -->
            </Grid.ColumnDefinitions>

            <!-- LEFT PANEL: File Queue -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="File Comparison Queue:" FontWeight="SemiBold" Margin="0,0,0,5"/>

                <ListBox Grid.Row="1" ItemsSource="{Binding FileQueue}" SelectedItem="{Binding SelectedQueuedFile}" 
         SelectionMode="Single" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <!-- Now binds to DisplayName and shows the full original FilePath on hover -->
                            <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" ToolTip="{Binding FilePath}"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel Grid.Row="2" Margin="0,10,0,0">
                    <Button Content="Add File(s)" Command="{Binding AddFilesCommand}" Margin="0,0,0,5" Height="25"/>
                    <!-- NEW BUTTON ADDED HERE -->
                    <Button Content="Set Nickname" Command="{Binding SetNicknameCommand}" Margin="0,0,0,5" Height="25"/>
                    <Button Content="Remove Selected" Command="{Binding RemoveFileCommand}" Margin="0,0,0,5" Height="25"/>
                    <Button Content="Clear Queue" Command="{Binding ClearQueueCommand}" Margin="0,0,0,15" Height="25"/>

                    
                    
                    <Button Content="Top Level Comparison" Command="{Binding RunTopLevelComparisonCommand}" Margin="0,0,0,5" Height="35" FontWeight="Bold" Background="#E8F5E9"/>
                    <Button Content="Schematic Comparison" Command="{Binding OpenReconciliationWindowCommand}" Margin="0,0,0,5" Height="35" FontWeight="Bold" Background="#FFF9C4"/>
                    <Button Content="Complete Comparison" Command="{Binding RunComparisonCommand}" Height="35" FontWeight="Bold" Background="#D4E6F1"/>
                </StackPanel>
            </Grid>

            <!-- RIGHT PANEL: DataGrid and Filters -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Search / Filter Bars -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10" Background="#F0F0F0">
                    <TextBlock Text="Global Search:" VerticalAlignment="Center" Margin="5,5,5,5" FontWeight="SemiBold"/>
                    <TextBox Text="{Binding SearchAllColumns, UpdateSourceTrigger=PropertyChanged}" Width="120" Margin="0,5,15,5"/>

                    <TextBlock Text="Filter Part No:" VerticalAlignment="Center" Margin="0,5,5,5"/>
                    <TextBox Text="{Binding SearchPartNo, UpdateSourceTrigger=PropertyChanged}" Width="100" Margin="0,5,15,5"/>

                    <TextBlock Text="Filter Issue Type:" VerticalAlignment="Center" Margin="0,5,5,5"/>
                    <ComboBox ItemsSource="{Binding AvailableIssueTypes}" SelectedItem="{Binding SearchIssueType, UpdateSourceTrigger=PropertyChanged}" Width="130" Margin="0,5,15,5"/>

                    <Button Content="Export Report" Command="{Binding ExportReportCommand}" Width="100" Margin="20,5,5,5"/>
                </StackPanel>

                <!-- Data Grid -->
                <DataGrid Grid.Row="1" ItemsSource="{Binding DifferencesView}" AutoGenerateColumns="False" IsReadOnly="True"
          SelectionUnit="CellOrRowHeader" ClipboardCopyMode="IncludeHeader" MouseDoubleClick="DataGrid_MouseDoubleClick">

                    
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Style.Triggers>
                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                    <Setter Property="Background" Value="#E3F2FD" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    

                    <DataGrid.Columns>
                        
                        <DataGridTextColumn Header="Part No" Binding="{Binding PartNo}" />
                        <DataGridTextColumn Header="Description" Binding="{Binding Description}" />
                        <DataGridTextColumn Header="Cost" Binding="{Binding Cost}" SortMemberPath="Cost" />
                        <DataGridTextColumn Header="Issue Type" Binding="{Binding IssueType}" />
                        <DataGridTextColumn Header="Details" Binding="{Binding Details}" Width="*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <!-- Enables the text wrapping to prevent horizontal scrolling -->
                                    <Setter Property="TextWrapping" Value="Wrap" />
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                    <Setter Property="Margin" Value="5,2,5,2" />

                                    <!-- Creates the custom floating ToolTip with a larger font -->
                                    <Setter Property="ToolTip">
                                        <Setter.Value>
                                            <ToolTip>
                                                <TextBlock Text="{Binding Details}" FontSize="18" FontWeight="SemiBold" MaxWidth="600" TextWrapping="Wrap"/>
                                            </ToolTip>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Status Dashboard Text -->
                <TextBlock Grid.Row="2" Text="{Binding StatusMessage}" Margin="0,10,0,0" FontWeight="SemiBold" Foreground="DarkSlateGray"/>
            </Grid>
        </Grid>

        <!-- Processing Overlay -->
        <Grid Background="#80000000" Panel.ZIndex="10" 
              Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis},FallbackValue=Collapsed}"
              d:IsHidden="True">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar IsIndeterminate="True" Width="150" Height="20" Margin="0,0,0,10"/>
                <TextBlock Text="Processing..." Foreground="White" FontWeight="Bold" HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>